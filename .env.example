# Copie este arquivo para .env e preencha os valores.
# Gere a SECRET_KEY com:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=troque-por-uma-chave-secreta-gerada-localmente
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./data/ecomonitor.db
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173

# Assistente de IA (OpenRouter)
# Crie a chave gratuita em https://openrouter.ai/keys
# Deixe OPENROUTER_API_KEY vazio para desativar o assistente com um erro amigável.
ASSISTENTE_HABILITADO=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT=30
OPENROUTER_SITE_URL=http://127.0.0.1:5173
OPENROUTER_SITE_NAME=EcoMonitor

# Central de Informações Ambientais (chaves opcionais; sem credenciais reais no repositório)
CENTRAL_CONTACT_EMAIL=contato@ecomonitor.local
OPENALEX_API_KEY=
GNEWS_API_KEY=
FIRMS_MAP_KEY=
CENTRAL_HTTP_TIMEOUT=15
CENTRAL_RATE_LIMIT_PER_MIN=60
CENTRAL_NEWS_REFRESH_HOURS=3
CENTRAL_ARTICLES_REFRESH_HOURS=24
CENTRAL_MONITORING_REFRESH_HOURS=24
CENTRAL_SCHEDULER_ENABLED=false
